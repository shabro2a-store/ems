FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate

COPY package.json pnpm-workspace.yaml ./
COPY packages/db/package.json packages/db/
COPY packages/notify/package.json packages/notify/
COPY packages/pdf/package.json packages/pdf/
COPY packages/time/package.json packages/time/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/

RUN rm -f pnpm-lock.yaml && pnpm install --shamefully-hoist

COPY packages/db/prisma ./packages/db/prisma
RUN pnpm --filter db exec prisma generate

COPY apps/web ./apps/web
COPY packages ./packages
WORKDIR /app/apps/web

RUN pnpm exec next build

FROM node:20-alpine
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
RUN addgroup -S -g 1001 nodejs && adduser -S -u 1001 -G nodejs nextjs
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next /app/apps/web/.next
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1))"
WORKDIR /app/apps/web
CMD ["/app/node_modules/.bin/next", "start", "-p", "3000"]
