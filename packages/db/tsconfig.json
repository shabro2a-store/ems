{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2020"],
    "baseUrl": ".",
    "paths": {
      "@db/*": ["./*"]
    }
  },
  "include": ["prisma/**/*", "src/**/*"],
  "exclude": ["node_modules"]
}