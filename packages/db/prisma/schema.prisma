generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  DRIVER
  ADMIN
  CALLER
}

enum PunchKind {
  IN
  OUT
}

enum OverrideKind {
  DAY_OFF
  HOURS_CHANGE
}

enum OverrideSource {
  ADMIN_DIRECT
  EMPLOYEE_REQUEST
  EMPLOYEE_DAY_OFF
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdjustmentKind {
  BONUS
  DEDUCTION
}

enum FlagKind {
  WATCHED
  MISSED_CHECKOUT
  TRIP_OVER_THRESHOLD
}

enum PenaltyKind {
  SHORTFALL
}

enum OvertimeDecisionKind {
  ACCEPTED
  REVOKED
}

enum CreditDecisionKind {
  ACCEPTED
  REVOKED
}

model User {
  id                   String             @id @default(cuid())
  username             String             @unique
  name                 String?
  password_hash        String
  role                 Role
  branch_id            String?
  branch               Branch?            @relation(fields: [branch_id], references: [id])
  hourly_rate_cent     Int
  // What the owner expects to pay this person monthly. Reference only: never
  // read by payout.ts or any other calculation, purely for the admin payroll
  // screen to display next to actual earnings. Edited freely, no history kept.
  expected_monthly_salary_cent Int?
  is_active            Boolean            @default(true)
  telegram_chat_id     String?
  notify_daily_summary Boolean            @default(true)
  notify_routine_pings Boolean            @default(true)
  created_at           DateTime           @default(now())
  punches              Punch[]
  rate_changes         RateChange[]
  schedules            Schedule[]
  schedule_overrides   ScheduleOverride[]
  leave_requests       LeaveRequest[]
  trips_as_driver      Trip[]             @relation("TripDriver")
  advances             Advance[]
  adjustments          Adjustment[]
  flags                Flag[]
  penalty_waivers      PenaltyWaiver[]
  penalty_acks         PenaltyAck[]
  overtimeDecisions    OvertimeDecision[]
  blockedCreditDecisions BlockedCreditDecision[]
  calls_received       DriverCall[]       @relation("CallsReceived")
  calls_made           DriverCall[]       @relation("CallsMade")
  push_subscriptions   PushSubscription[]
  blocked_punches      BlockedPunchAttempt[]

  @@index([branch_id])
}

model Branch {
  id                 String  @id @default(cuid())
  name               String
  lat                Float
  lng                Float
  gps_radius_m       Int     @default(50)
  gps_accuracy_max_m Int     @default(100)
  // The tolerance either side of a day's required hours: an overrun smaller
  // than this raises no overtime notice, a shortfall smaller than this incurs
  // no penalty. Named for the shift, not for one direction of missing it -
  // it governs both.
  shift_grace_min    Int     @default(15)
  trip_threshold_min Int     @default(30)
  is_active          Boolean @default(true)
  users              User[]
  punches            Punch[]
  trips              Trip[]
  flags              Flag[]
  blocked_punches    BlockedPunchAttempt[]
}

model Punch {
  id                String    @id @default(cuid())
  user_id           String
  user              User      @relation(fields: [user_id], references: [id])
  branch_id         String
  branch            Branch    @relation(fields: [branch_id], references: [id])
  kind              PunchKind
  at                DateTime
  lat               Float
  lng               Float
  accuracy_m        Int
  device_fp         String
  ip                String
  corrected         Boolean   @default(false)
  corrected_by      String?
  correction_reason String?
  // No human made this punch. Set only by the auto-close job, which writes the
  // checkout an abandoned check-in never got. Everything downstream treats it
  // as a normal punch on purpose - it has to pay and to be correctable like
  // any other - so this exists to stop it being read as evidence that somebody
  // stood at the branch and pressed a button, which the lat/lng of a system
  // punch (the branch's own coordinates) would otherwise imply.
  system_generated  Boolean   @default(false)
  created_at        DateTime  @default(now())

  @@index([user_id, at])
  @@index([branch_id, at])
}

// A check-in the system refused because the employee still had an open session
// from an earlier shift they forgot to close.
//
// Written ONLY after verifyWithinGeofence has passed. That ordering is the
// whole value of the row: punchEmployee calls verifyWithinGeofence before it
// looks at the session state, so a rejection carrying ALREADY_PUNCHED_IN has
// already proved the person is standing at their branch with acceptable GPS.
// An attempt from home fails earlier as OUT_OF_GEOFENCE and never reaches
// recordBlockedAttempt. That is what makes the paid credit these rows drive
// ungameable, and it is why nothing may record one from a path that skips the
// geofence - notably POST /api/me/punch/dev.
model BlockedPunchAttempt {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  branch_id  String
  branch     Branch   @relation(fields: [branch_id], references: [id])
  at         DateTime
  // The check-in that was in the way, so the message and the audit trail can
  // both name the shift the employee has to get closed.
  open_in_at DateTime
  lat        Float
  lng        Float
  accuracy_m Int
  device_fp  String
  ip         String
  created_at DateTime @default(now())

  @@index([user_id, at])
  @@index([branch_id, at])
}

model RateChange {
  id             String   @id @default(cuid())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id])
  rate_cent      Int
  effective_from DateTime
  created_at     DateTime @default(now())

  @@index([user_id, effective_from])
}

model Schedule {
  id        String @id @default(cuid())
  user_id   String
  user      User   @relation(fields: [user_id], references: [id])
  weekday   Int
  shift_min Int
  // Raw SQL CHECK in migration:
  //   ALTER TABLE "Schedule" ADD CONSTRAINT schedule_weekday_chk CHECK (weekday BETWEEN 0 AND 6);
  //   ALTER TABLE "Schedule" ADD CONSTRAINT schedule_shift_min_chk CHECK ("shift_min" IS NULL OR ("shift_min" >= 0 AND "shift_min" <= 1440));

  @@unique([user_id, weekday])
}

model ScheduleOverride {
  id         String         @id @default(cuid())
  user_id    String
  user       User           @relation(fields: [user_id], references: [id])
  date       DateTime       @db.Date
  kind       OverrideKind
  shift_min  Int?
  note       String?
  source     OverrideSource
  created_at DateTime       @default(now())
  // Raw SQL CHECK in migration:
  //   ALTER TABLE "ScheduleOverride" ADD CONSTRAINT override_shift_min_chk CHECK ("shift_min" IS NULL OR ("shift_min" >= 0 AND "shift_min" <= 1440));

  @@unique([user_id, date])
}

model LeaveRequest {
  id         String        @id @default(cuid())
  user_id    String
  user       User          @relation(fields: [user_id], references: [id])
  kind       OverrideKind
  start_date DateTime      @db.Date
  end_date   DateTime      @db.Date
  off_min    Int?
  note       String?
  status     RequestStatus
  decided_by String?
  decided_at DateTime?
  created_at DateTime      @default(now())
  // Raw SQL CHECK in migration:
  //   ALTER TABLE "LeaveRequest" ADD CONSTRAINT leave_range_chk CHECK (end_date >= start_date);
  //   ALTER TABLE "LeaveRequest" ADD CONSTRAINT leave_off_min_chk CHECK ("off_min" IS NULL OR ("off_min" >= 0 AND "off_min" <= 1440));

  @@index([user_id, status])
}

model Trip {
  id                   String    @id @default(cuid())
  driver_id            String
  driver               User      @relation("TripDriver", fields: [driver_id], references: [id])
  branch_id            String
  branch               Branch    @relation(fields: [branch_id], references: [id])
  out_at               DateTime
  out_lat              Float
  out_lng              Float
  back_at              DateTime?
  back_lat             Float?
  back_lng             Float?
  over_threshold       Boolean   @default(false)
  threshold_alerted_at DateTime?
  // Raw SQL in migration:
  //   CREATE UNIQUE INDEX trip_one_open ON "Trip"(driver_id) WHERE back_at IS NULL;
  //   CREATE INDEX trip_open_by_branch ON "Trip"(branch_id) WHERE back_at IS NULL;  -- supports /api/admin/now

  @@index([driver_id, out_at])
}

model Advance {
  id          String        @id @default(cuid())
  user_id     String
  user        User          @relation(fields: [user_id], references: [id])
  amount_cent Int
  reason      String?
  status      RequestStatus
  decided_by  String?
  decided_at  DateTime?
  created_at  DateTime      @default(now())

  @@index([user_id, status])
}

model Adjustment {
  id          String         @id @default(cuid())
  user_id     String
  user        User           @relation(fields: [user_id], references: [id])
  period      DateTime       @db.Date
  kind        AdjustmentKind
  amount_cent Int
  reason      String
  created_by  String
  created_at  DateTime       @default(now())
  // Raw SQL CHECK in migration:
  //   ALTER TABLE "Adjustment" ADD CONSTRAINT adjustment_amount_chk CHECK (amount_cent >= 0);
  //   ALTER TABLE "Adjustment" ADD CONSTRAINT adjustment_period_chk CHECK (EXTRACT(DAY FROM period) = 1);

  @@index([user_id, period])
}

// Late/early-leave penalties are COMPUTED on the fly from each day's schedule vs
// actual punches (see lib/services/penalty.ts) — not stored. A PenaltyWaiver is
// the admin "remove penalty" action: it cancels the auto-penalty for one
// (user, day, kind). It can never touch a manual Adjustment.
model PenaltyWaiver {
  id         String      @id @default(cuid())
  user_id    String
  user       User        @relation(fields: [user_id], references: [id])
  date       DateTime    @db.Date
  kind       PenaltyKind
  // The minutes this day's penalty stood at when the owner ruled. One row per
  // (user, day, kind), but the penalty moves whenever a punch is corrected -
  // and the owner corrects punches by hand routinely - so the ruling has to
  // name the amount it was made against: it only counts while this still
  // equals the day's current penalty minutes. Null is treated as stale, which
  // is what makes any pre-column row need no backfill.
  penalty_min Int?
  reason     String?
  waived_by  String
  created_at DateTime    @default(now())

  @@unique([user_id, date, kind])
  @@index([user_id, date])
}

// The admin has seen an auto-computed penalty and let it stand. Unlike a
// PenaltyWaiver this changes no money — it only takes the notice off the
// attention queue, which otherwise recomputes it forever.
model PenaltyAck {
  id              String      @id @default(cuid())
  user_id         String
  user            User        @relation(fields: [user_id], references: [id])
  date            DateTime    @db.Date
  kind            PenaltyKind
  // The minutes this day's penalty stood at when the owner ruled. One row per
  // (user, day, kind), but the penalty moves whenever a punch is corrected -
  // and the owner corrects punches by hand routinely - so the ruling has to
  // name the amount it was made against: it only counts while this still
  // equals the day's current penalty minutes. Null is treated as stale, which
  // is what makes any pre-column row need no backfill.
  penalty_min Int?
  acknowledged_by String
  created_at      DateTime    @default(now())

  @@unique([user_id, date, kind])
  @@index([user_id, date])
}

// The owner has reviewed a day's overtime. No row means pending, and pending
// overtime is already paid - pairHours pays every minute worked. REVOKED makes
// payroll subtract that day's excess.
model OvertimeDecision {
  id         String               @id @default(cuid())
  user_id    String
  user       User                 @relation(fields: [user_id], references: [id])
  date       DateTime             @db.Date
  decision   OvertimeDecisionKind
  // The day's overtime minutes at the moment the owner ruled. One row per
  // calendar day, but the day's overtime can grow after the ruling, so the
  // ruling has to name the amount it was made against: a decision only counts
  // while this still equals the day's current overtime. Null is treated as
  // stale, which is what makes any pre-column row harmless without a backfill.
  overtime_min Int?
  reason     String?
  decided_by String
  created_at DateTime             @default(now())

  @@unique([user_id, date])
  @@index([user_id, date])
}

// The owner's ruling on one day's blocked-time credit. No row means pending,
// and pending credit grants NOTHING - the inverse of OvertimeDecision, where
// the pending day is the paid one. ACCEPTED is what puts the minutes into gross
// and clears that day's shortfall; REVOKED moves no money at all and only
// clears the notice, which is why nothing anywhere carries a deduction line for
// it. A stale ruling reads as pending, so it withholds rather than pays.
model BlockedCreditDecision {
  id           String             @id @default(cuid())
  user_id      String
  user         User               @relation(fields: [user_id], references: [id])
  date         DateTime           @db.Date
  decision     CreditDecisionKind
  // The day's credited minutes at the moment the owner ruled. One row per
  // calendar day, but a punch correction moves what the day is owed and so
  // moves the credit with it; a ruling has to name the amount it was made
  // against. Null is treated as stale, so any pre-column row needs no backfill.
  credited_min Int?
  reason       String?
  decided_by   String
  created_at   DateTime           @default(now())

  @@unique([user_id, date])
  @@index([user_id, date])
}

// A device's Web Push subscription (one per browser/device), used to ring a
// driver's phone even when the app is closed or the phone is locked.
model PushSubscription {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now())

  @@index([user_id])
}

// A caller (POS cashier) ringing a driver's phone. Read by the driver's app to
// raise an alarm; kept for history. The caller never starts/ends trips.
model DriverCall {
  id              String    @id @default(cuid())
  driver_id       String
  driver          User      @relation("CallsReceived", fields: [driver_id], references: [id])
  caller_id       String
  caller          User      @relation("CallsMade", fields: [caller_id], references: [id])
  branch_id       String?
  created_at      DateTime  @default(now())
  acknowledged_at DateTime?
  // Set to the Trip this call dispatched when the driver goes out on the order.
  // A driver can only start a trip against a recent, unconsumed call — this
  // prevents undispatched "out on order" trips and ties each trip to its call.
  trip_id         String?

  @@index([driver_id, created_at])
}

model Flag {
  id           String    @id @default(cuid())
  kind         FlagKind
  user_id      String?
  user         User?     @relation(fields: [user_id], references: [id])
  branch_id    String?
  branch       Branch?   @relation(fields: [branch_id], references: [id])
  context_json Json
  created_at   DateTime  @default(now())
  // When an alert about this flag was sent out. NOT a resolution marker.
  notified_at  DateTime?
  // When a human dealt with it (admin dismissed, or the employee punched and
  // auto-cleared it). Kept separate from notified_at: conflating the two let the
  // 23:30 sweep silently drop flags nobody had reviewed.
  resolved_at  DateTime?

  @@index([created_at(sort: Desc)])
  @@index([resolved_at])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor_id    String
  action      String
  entity      String
  entity_id   String
  before_json Json?
  after_json  Json?
  at          DateTime @default(now())
  // REVOKE UPDATE, DELETE ON audit_log FROM ems_app;  (applied in migration)

  @@index([entity, entity_id])
}

model IdempotencyKey {
  key           String
  user_id       String
  response_json Json
  status_code   Int
  created_at    DateTime @default(now())
  expires_at    DateTime

  @@id([key, user_id])
  @@index([expires_at])
}

model RateLimitBucket {
  identifier  String   @id
  tokens      Int
  refilled_at DateTime @default(now())
}
