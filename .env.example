# ---------------------------------------------------------------------------
# PRODUCTION (VPS) — /opt/ems/.env must contain at least:
#   JWT_SECRET=<openssl rand -hex 32>          # REQUIRED; docker compose fails without it
#   APP_DB_PASSWORD=<openssl rand -hex 24>     # REQUIRED; the app's own DB login
#   POSTGRES_PASSWORD=...                      # REQUIRED; no default. On a server that
#                                              # already has a Postgres volume this MUST be
#                                              # the password the volume was created with
#                                              # (ems_dev_password) — it is not applied to an
#                                              # existing database, only used to log in to it.
#                                              # Rotate later with ALTER USER; see DEPLOY.md.
#   PUBLIC_APP_URL=https://app.shabro2a.com    # makes cookies Secure
#   ENABLE_DEV_ENDPOINTS=false                 # keep the GPS-bypass endpoints OFF
# docker-compose.yml reads these via ${VAR} substitution.
# ---------------------------------------------------------------------------

# In-container value (what docker-compose.yml builds for you — the db service
# is reachable as the host `db`). For running the app on your laptop against
# the compose Postgres instead, use:
#   DATABASE_URL=postgresql://ems:ems_dev_password@localhost:5433/ems
# Postgres publishes on 127.0.0.1:5433 only, so `localhost` is the sole route in
# from outside the compose network.
DATABASE_URL=postgresql://ems:ems_dev_password@db:5432/ems
# Required — docker compose refuses to start without it. Both halves of
# DATABASE_URL and this value must agree.
POSTGRES_PASSWORD=ems_dev_password

# Required in production. web and worker log in as the ems_app role with this
# (rows only - no schema changes, no rewriting the audit log); the migrate
# service sets it on every deploy. Letters, digits, - and _ only, 16+ chars.
# Local dev can keep using the owner URL above and leave this unused.
APP_DB_PASSWORD=<openssl rand -hex 24>

JWT_SECRET=<64 hex characters; generate with: openssl rand -hex 32>

# NODE_ENV: 'development' for local HTTP (cookies not Secure-flagged).
#           'production' for HTTPS (cookies get Secure flag).
NODE_ENV=development

# Dev GPS bypass. 'true' exposes /api/me/punch/dev and shows the Dev IN/OUT
# buttons (laptops have no real GPS). MUST be false in production.
# One value feeds both vars; the NEXT_PUBLIC_ copy is what the browser reads.
ENABLE_DEV_ENDPOINTS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=<32 hex characters; openssl rand -hex 16>
PUBLIC_APP_URL=https://app.example.com

# Web Push — lets the caller's ring reach a locked/closed driver phone.
# Optional: leave unset and the ring still works as an in-app alarm only.
# Generate one keypair with the command in DEPLOY.md "Web Push" (it runs inside
# the web container, where web-push is installed).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shabro2a.com

# Error monitoring, web and worker. Unset = Sentry stays off. Only initialises
# when NODE_ENV=production.
SENTRY_DSN=

# Backups themselves are not configured here: scripts/backup.sh runs from root's
# crontab and reads its passphrase from /etc/ems/backup.key (RUNBOOK.md section 3).
# Once it runs, set this and the worker checks each morning that last night's
# backup succeeded (Telegram "Backup missing" otherwise). Empty = no check.
BACKUP_WATCH_DIR=
# Only if backup.sh writes somewhere other than /var/backups/ems: the folder the
# worker mounts read-only at /backups.
# BACKUP_LOCAL_DIR=/var/backups/ems
