# ---------------------------------------------------------------------------
# PRODUCTION (VPS) — /opt/ems/.env must contain at least:
#   JWT_SECRET=<openssl rand -hex 32>        # REQUIRED; docker compose fails without it
#   PUBLIC_APP_URL=https://app.shabro2a.com  # makes cookies Secure
#   ENABLE_DEV_ENDPOINTS=false               # keep the GPS-bypass endpoints OFF
#   POSTGRES_PASSWORD=<optional; defaults to ems_dev_password if unset>
# docker-compose.yml reads these via ${VAR} substitution.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://ems:ems@db:5432/ems
POSTGRES_PASSWORD=ems

JWT_SECRET=<64-byte-hex; generate with: openssl rand -hex 32>

# NODE_ENV: 'development' for local HTTP (cookies not Secure-flagged).
#           'production' for HTTPS (cookies get Secure flag).
NODE_ENV=development

ACCESS_COOKIE_NAME=ems_access
REFRESH_COOKIE_NAME=ems_refresh
CSRF_COOKIE_NAME=csrf

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=<random-32-bytes; openssl rand -hex 16>
PUBLIC_APP_URL=https://app.example.com

SENTRY_DSN=

BACKUP_GPG_PASSPHRASE_PATH=/run/secrets/backup.key
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
