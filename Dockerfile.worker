# Node 22 LTS, pinned to the exact image; docker-compose.yml says how to move it.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
RUN apk add --no-cache openssl
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/db/package.json packages/db/
COPY packages/notify/package.json packages/notify/
COPY packages/pdf/package.json packages/pdf/
COPY packages/time/package.json packages/time/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/

# The lockfile CI tested, exactly: a build that resolved the caret ranges
# afresh ran whatever the registry served that day, untested and unpinned.
RUN pnpm install --frozen-lockfile --shamefully-hoist

COPY packages/db/prisma ./packages/db/prisma
RUN pnpm --filter db exec prisma generate

COPY packages ./packages
COPY apps ./apps
# One bundled file run by plain node: no TypeScript translation at every start.
RUN pnpm --filter worker build
ENV NODE_ENV=production
RUN addgroup -S -g 1001 nodejs && adduser -S -u 1001 -G nodejs worker
USER worker
# Healthy while the worker keeps writing its heartbeat (apps/worker/src/heartbeat.ts:
# a real query every 30 s, then the time). Stale for 2 minutes - hung, or unable
# to reach the database - is unhealthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "const t=Date.parse(require('fs').readFileSync('/tmp/ems-worker-heartbeat','utf8'));process.exit(Date.now()-t<=120000?0:1)"
WORKDIR /app/apps/worker
CMD ["node", "dist/index.js"]
